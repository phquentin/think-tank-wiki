# Sensitive or copyrighted originals: personal records, paywalled full texts,
# anything that must not reach the remote. Readable by the agent locally; the
# digest in wiki/sources/ is the durable artifact. Keep the folder itself.
raw/private/*
!raw/private/.gitkeep

# Obsidian: personal vault state (layout, plugins, themes, hotkeys).
.obsidian/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Tooling caches
__pycache__/
*.pyc
.venv/
node_modules/
